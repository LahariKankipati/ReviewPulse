# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).

# --- Database ---
# Supabase: enable pgvector in Extensions first, then paste the connection string
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# --- Active LLM provider: Groq (free tier at console.groq.com) ---
GROQ_API_KEY=gsk_...

# --- Active embedding provider: Jina AI (free tier at jina.ai) ---
JINA_API_KEY=jina_...

# --- Frontend origins allowed to call this API (comma-separated) ---
CORS_ORIGINS=http://localhost:5173

# --- Webhook signing (N10) — optional, leave blank to disable ---
WEBHOOK_SECRET=dev-webhook-hmac-secret
WEBHOOK_URL=

# --- Admin secret — protects POST /api/admin/refresh and GET /api/metrics ---
# Set the same value in GitHub Actions secrets as ADMIN_SECRET
ADMIN_SECRET=dev-admin-secret-change-me

ENVIRONMENT=development
