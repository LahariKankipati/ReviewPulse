# Copy to .env and fill in. NEVER commit the real .env (it's gitignored).

# --- Database (Supabase gives you this connection string; use the asyncpg form) ---
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# --- Redis (Upstash free tier gives you a rediss:// URL) ---
REDIS_URL=redis://localhost:6379/0

# --- LLM providers (you only strictly need ONE to run; two satisfies N2) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_DIM=768

# --- Auth: copy the JWT secret from Supabase > Project Settings > API > JWT Secret ---
SUPABASE_JWT_SECRET=dev-insecure-secret-change-me

# --- Frontend origin(s) allowed to call this API (comma-separated) ---
CORS_ORIGINS=http://localhost:5173

# --- Webhook signing (N10) ---
WEBHOOK_SECRET=dev-webhook-hmac-secret

ENVIRONMENT=development
